  "metric_registry": [
    {
      "key": "recent_movement",
      "family": "workload",
      "label": "Recent movement",
      "unit": "sessions",
      "source": "local transcript or activity-log events",
      "window": "config.idle_gap_seconds",
      "missing_state": "unavailable when no local activity event is available",
      "description": "Counts sessions with local event movement inside the active window; visible processes alone do not make this non-zero."
    },
    {
      "key": "known_sessions",
      "family": "workload",
      "label": "Known sessions",
      "unit": "sessions",
      "source": "transcripts, command hints, or fallback session ids",
      "missing_state": "zero only means no session evidence was observed",
      "description": "Counts observed AI-agent sessions and role splits; process-only rows are not promoted into sessions."
    },
    {
      "key": "process_pressure",
      "family": "runtime",
      "label": "Process pressure",
      "unit": "pids",
      "source": "visible local AI process rows",
      "missing_state": "zero means no visible matching process at sample time",
      "description": "Counts visible local PIDs separately from recent movement or known sessions."
    },
    {
      "key": "process_resources",
      "family": "runtime",
      "label": "Process resources",
      "unit": "cpu/memory/io",
      "source": "per-PID local process counters",
      "missing_state": "unavailable when the operating system counter cannot be read",
      "description": "CPU, memory, and disk I/O are diagnostic process evidence and must not imply agent activity by themselves."
    },
    {
      "key": "system_resources",
      "family": "system",
      "label": "System resources",
      "unit": "cpu/memory/disk/network/thermal pressure",
      "source": "whole-machine OS counters and public macOS thermal state when available",
      "missing_state": "unavailable when system sampling is unsupported; thermal state is separately unavailable when the public API cannot provide it",
      "description": "Whole-machine pressure is useful context, but it is not attributed to AI agents without process evidence. Thermal pressure is not a temperature or fan-speed reading."
    },
    {
      "key": "role_matrix",
      "family": "lineage",
      "label": "Agent role matrix",
      "unit": "sessions",
      "source": "thread source, parent thread, lane paths, and independent-run evidence",
      "missing_state": "unknown role when no reliable role evidence exists",
      "description": "Main-agent and subagent counts are session-level facts and should not be guessed from process names alone."
    },
    {
      "key": "tool_coverage",
      "family": "coverage",
      "label": "Tool coverage",
      "unit": "sessions/pids",
      "source": "per-tool aggregation of known sessions, recent movement, and process pressure",
      "missing_state": "zero only means no session or process evidence was observed for that tool",
      "description": "Per-tool rows keep known sessions, recent movement, and process pressure as separate rails; process pressure must not be treated as recent movement."
    },
    {
      "key": "token_usage",
      "family": "economics",
      "label": "Token usage",
      "unit": "tokens",
      "source": "parsed local transcript usage fields",
      "missing_state": "unavailable when usage fields are absent; never infer zero from process duration",
      "description": "Token totals are measured only when the local trace contains usage fields."
    },
    {
      "key": "output_token_throughput",
      "family": "workload",
      "label": "Output token throughput",
      "unit": "output tokens/second",
      "source": "positive output-token events and safe cumulative-output deltas from local transcripts",
      "window": "trailing 300 seconds of wall time",
      "missing_state": "unavailable, no_data, and stale remain distinct from a measured zero rate",
      "description": "Divides output tokens attributed to the trailing wall-time window by 300 seconds; cumulative deltas spanning sparse observations are distributed uniformly across their observed interval. This is workload throughput, not model decode speed."
    },
    {
      "key": "runtime_telemetry",
      "family": "adapter",
      "label": "Runtime telemetry",
      "source": "optional future OpenTelemetry or JSONL runtime adapters",
      "missing_state": "absent unless an adapter is configured",
      "description": "Imported runtime telemetry can strengthen evidence but must not replace local process/session truth."
    },
    {
      "key": "diagnostic_export",
      "family": "diagnostics",
      "label": "Diagnostic export",
      "source": "sanitized local snapshot",
      "missing_state": "available when the local server can produce a sanitized snapshot",
      "description": "Exports a minimized evidence bundle that omits raw prompts, absolute paths, command arguments, and environment variables."
    }
  ],
  "diagnostics": {
    "generated_at": "<instant>",
    "evolution": [
      {
        "key": "evidence_boundary",
